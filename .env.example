# Set DEV_MODE=true locally to relax rate limits (100/hour per Build/Analyze mode)
# Set DEV_MODE_DISABLE_RATE_LIMIT=true to skip rate limiting entirely in dev
DEV_MODE=false

GROQ_API_KEY=your_groq_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
LLM_PROVIDER=groq

# Webull: local dev only — do NOT set in Streamlit Community Cloud secrets for a public app
WEBULL_APP_KEY=your_webull_app_key
WEBULL_APP_SECRET=your_webull_app_secret
WEBULL_ENV=sandbox
WEBULL_ACCOUNT_ID=

FINNHUB_API_KEY=your_finnhub_key
